{
  "name": "@whanext/core",
  "version": "0.19.4",
  "description": "A modern, high-level WhatsApp SDK for TypeScript with commands, groups, media, moderation and structured logging.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "MIGRATING_TO_ZAPO.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "npm run build && npm run typecheck && npm test",
    "dev": "tsup --watch",
    "example": "node --import tsx --env-file=.env examples/index.ts",
    "prepublishOnly": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@zapo-js/media-utils": "1.0.0",
    "@zapo-js/store-sqlite": "1.1.0",
    "better-sqlite3": "^12.6.2",
    "file-type": "^19.0.0",
    "sharp": "^0.33.0",
    "zapo-js": "1.7.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "keywords": [
    "whatsapp",
    "zapo",
    "typescript",
    "bot",
    "sdk",
    "automation",
    "commands",
    "moderation",
    "whatsapp-bot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luanxdd/whanext-core.git"
  },
  "bugs": {
    "url": "https://github.com/luanxdd/whanext-core/issues"
  },
  "homepage": "https://github.com/luanxdd/whanext-core#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
